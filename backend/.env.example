# Postgres
DATABASE_URL=postgresql+psycopg2://radar:radar@localhost:5432/radar

# Redis
REDIS_URL=redis://localhost:6379/0

# App
APP_NAME=Radar
SECRET_KEY=change-me-generate-a-long-random-string
ENVIRONMENT=development
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# SMTP (email notifications). Convention: use SMTP_BACKEND=console in dev to print emails instead of sending.
SMTP_BACKEND=console
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Radar <no-reply@radar.example>
EMAIL_FROM_NAME=Radar

# Stripe (test mode keys)
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
STRIPE_PRICE_STARTER=price_starter
STRIPE_PRICE_PRO=price_pro
STRIPE_PRICE_BUSINESS=price_business
STRIPE_TRIAL_DAYS=14

# Monitoring / jobs
MAX_CONCURRENT_SCRAPES=8
SCRAPE_TIMEOUT_SECONDS=30
Scheduler_POLL_SECONDS=30

# Logging
LOG_LEVEL=INFO